{
  "name": "braid",
  "type": "module",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "description": "Domain model framework that merges product intent with shipped code into a single HITL-validated model the whole team can read.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --parallel --filter=@braidhq/server --filter=@braidhq/studio",
    "dev:desktop": "turbo run dev --filter=@braidhq/desktop",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:integration": "turbo run test:integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.12.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.16.0",
    "lint-staged": "^15.2.0",
    "simple-git-hooks": "^2.11.0",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "kuzu",
      "simple-git-hooks"
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "cmake-js": "^8.0.0",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "tar": "^7.5.22",
      "zod": "^4.2.1"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,yml,yaml,md}": "eslint --fix"
  }
}
