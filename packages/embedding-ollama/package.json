{
  "name": "@braidhq/embedding-ollama",
  "type": "module",
  "version": "0.4.2",
  "description": "Ollama embedding plugin for Braid. Runs any Ollama-served model, so vectors are produced on your own host and no text leaves it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroops0111/braid.git",
    "directory": "packages/embedding-ollama"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@braidhq/core": "workspace:*",
    "@braidhq/schema": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
