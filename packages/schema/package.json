{
  "name": "@braidhq/schema",
  "type": "module",
  "version": "0.2.1",
  "description": "Zod schemas and branded TypeScript types for the Braid domain. The wire-format contract for all Braid packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroops0111/braid.git",
    "directory": "packages/schema"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@braidhq/test-utils": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
