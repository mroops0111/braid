{
  "name": "@braidhq/source-loader-git",
  "type": "module",
  "version": "0.0.1",
  "description": "Git source-loader plugin: clone a remote repo into a workspace source path; sync via fetch + reset.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@braidhq/core": "workspace:*",
    "@braidhq/schema": "workspace:*",
    "simple-git": "^3.36.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
