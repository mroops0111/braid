{
  "name": "@braidhq/desktop",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Tauri desktop shell for Braid.",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "echo 'desktop#build is a no-op in CI; run `pnpm --filter @braidhq/desktop bundle` to produce a Tauri installer.'",
    "bundle": "tauri build",
    "tauri": "tauri",
    "typecheck": "echo 'desktop has no TypeScript sources; frontend lives in @braidhq/studio.'",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .turbo src-tauri/target"
  },
  "dependencies": {
    "@braidhq/schema": "workspace:*",
    "@braidhq/server": "workspace:*",
    "@braidhq/studio": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0"
  }
}
