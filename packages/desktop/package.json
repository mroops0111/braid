{
  "name": "@braidhq/desktop",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "description": "Tauri desktop shell for Braid.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroops0111/braid.git",
    "directory": "packages/desktop"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:remote": "BRAID_DESKTOP_REMOTE_ONLY=1 tauri dev --config src-tauri/tauri.remote.conf.json",
    "build": "echo 'skipped (run `pnpm --filter @braidhq/desktop bundle` for an installer)'",
    "bundle": "tauri build",
    "bundle:remote": "tauri build --config src-tauri/tauri.remote.conf.json",
    "tauri": "tauri",
    "prepare-sidecar": "node scripts/prepare-sidecar.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --coverage",
    "clean": "rm -rf .turbo src-tauri/target src-tauri/binaries src-tauri/resources"
  },
  "dependencies": {
    "@braidhq/schema": "workspace:*",
    "@braidhq/server": "workspace:*",
    "@braidhq/studio": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
