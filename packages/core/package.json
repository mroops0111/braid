{
  "name": "@braidhq/core",
  "type": "module",
  "version": "0.0.1",
  "description": "Domain entities, application services, and plugin port interfaces for Braid. The framework engine; no concrete adapters.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@braidhq/schema": "workspace:*",
    "neo4j-driver": "^6.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "simple-git": "^3.27.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@braidhq/test-utils": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
