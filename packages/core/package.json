{
  "name": "@braidhq/core",
  "type": "module",
  "version": "0.5.0",
  "description": "Domain entities, application services, and plugin port interfaces for Braid. The framework engine; no concrete adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroops0111/braid.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": "./src/index.ts",
    "./in-memory": "./src/in-memory.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@braidhq/schema": "workspace:*",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "simple-git": "^3.27.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@braidhq/test-utils": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./in-memory": {
        "types": "./dist/in-memory.d.ts",
        "default": "./dist/in-memory.js"
      }
    }
  }
}
