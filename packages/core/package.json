{
  "name": "@telos/core",
  "type": "module",
  "version": "0.0.0",
  "description": "Telos core: domain entities (workspace / model / proposal / qa / ...) + application services + infrastructure ports.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --passWithNoTests --config vitest.integration.config.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@telos/schema": "workspace:*",
    "neo4j-driver": "^6.0.1",
    "pino": "^9.5.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
