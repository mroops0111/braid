{
  "name": "@braidhq/cli",
  "type": "module",
  "version": "0.0.1",
  "description": "Braid command-line interface. cac + ink.",
  "license": "MIT",
  "main": "./src/main.ts",
  "bin": {
    "braid": "./bin/braid.mjs"
  },
  "files": [
    "README.md",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@braidhq/core": "workspace:*",
    "@braidhq/schema": "workspace:*",
    "@braidhq/server": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "cac": "^6.7.14",
    "ink": "^5.1.0",
    "picocolors": "^1.1.0",
    "react": "^19.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@braidhq/test-utils": "workspace:*",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
