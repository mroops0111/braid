{
  "name": "@telos/cli",
  "type": "module",
  "version": "0.0.0",
  "description": "Telos command-line interface. cac + ink.",
  "license": "Apache-2.0",
  "main": "./src/main.ts",
  "bin": {
    "telos": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@telos/core": "workspace:*",
    "@telos/schema": "workspace:*",
    "cac": "^6.7.14",
    "ink": "^5.1.0",
    "picocolors": "^1.1.0",
    "react": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
