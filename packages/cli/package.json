{
  "name": "@braidhq/cli",
  "type": "module",
  "version": "0.1.0",
  "description": "Command-line entry point for Braid.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroops0111/braid.git",
    "directory": "packages/cli"
  },
  "main": "./src/main.ts",
  "bin": {
    "braid": "./bin/braid.mjs"
  },
  "files": [
    "README.md",
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@braidhq/core": "workspace:*",
    "@braidhq/schema": "workspace:*",
    "@braidhq/server": "workspace:*",
    "@hono/node-server": "^2.0.5",
    "cac": "^7.0.0",
    "ink": "^5.1.0",
    "picocolors": "^1.1.0",
    "react": "^19.2.7",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@braidhq/test-utils": "workspace:*",
    "@types/react": "^19.2.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
