{
  "name": "@braidhq/storage-kuzu",
  "type": "module",
  "version": "0.1.0",
  "description": "Embedded Kuzu graph-storage plugin for Braid. Zero-infra single-binary alternative to Neo4j.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroops0111/braid.git",
    "directory": "packages/storage-kuzu"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node scripts/test-with-retry.mjs",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@braidhq/core": "workspace:*",
    "@braidhq/schema": "workspace:*",
    "@braidhq/sdk": "workspace:*",
    "kuzu": "^0.11.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@braidhq/test-utils": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
