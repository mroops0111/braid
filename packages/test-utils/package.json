{
  "name": "@braidhq/test-utils",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test fixtures for the Braid monorepo. Never published.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
