{
  "name": "@braidhq/source-loader-mcp",
  "type": "module",
  "version": "0.4.2",
  "description": "MCP source-loader plugin for Braid. Mirror an API-backed source into markdown through an MCP tool.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mroops0111/braid.git",
    "directory": "packages/source-loader-mcp"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@braidhq/core": "workspace:*",
    "@braidhq/schema": "workspace:*",
    "@braidhq/sdk": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@braidhq/test-utils": "workspace:*",
    "@hono/node-server": "^1.19.6",
    "@modelcontextprotocol/server": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
